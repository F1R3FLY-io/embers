# embers staging secrets — TEMPLATE.
#
# Copy this file to `embers-staging.secrets.env` (which is .gitignore'd) and fill in
# REAL values. docker-compose-staging.yaml loads it via `env_file`. NEVER commit the
# filled-in file. See docs/security/key-inventory.md for what each key protects and
# its rotation semantics.
#
# All *_KEY values are 64 hex chars (32 bytes). ENCRYPTION_KEY must differ from
# CAPABILITY_KEY (embers validates this at startup).

# --- backend AES key ---
EMBERS__AES_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX

# --- mainnet secrets ---
EMBERS__MAINNET__SERVICE_KEY=REPLACE_WITH_32_BYTE_HEX
EMBERS__MAINNET__WALLETS_ENV_KEY=REPLACE_WITH_32_BYTE_HEX
EMBERS__MAINNET__AGENTS_ENV_KEY=REPLACE_WITH_32_BYTE_HEX
EMBERS__MAINNET__AGENTS_TEAMS_ENV_KEY=REPLACE_WITH_32_BYTE_HEX
EMBERS__MAINNET__OSLFS_ENV_KEY=REPLACE_WITH_32_BYTE_HEX

# --- testnet secrets ---
EMBERS__TESTNET__SERVICE_KEY=REPLACE_WITH_32_BYTE_HEX
EMBERS__TESTNET__ENV_KEY=REPLACE_WITH_32_BYTE_HEX

# --- continuation store (ENCRYPTION_KEY != CAPABILITY_KEY) ---
EMBERS__CONTINUATION_STORE__ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX
EMBERS__CONTINUATION_STORE__CAPABILITY_KEY=REPLACE_WITH_A_DIFFERENT_32_BYTE_HEX
# Must be INSIDE the F1r3drive mount and under the wallet dir the drive unlocks,
# i.e. <F1R3DRIVE_MOUNT>/<F1R3DRIVE_WALLET_ADDRESS>/... (see the compose's
# F1R3DRIVE_MOUNT=/mnt/f1r3drive).
EMBERS__CONTINUATION_STORE__MOUNT_PATH=/mnt/f1r3drive/REPLACE_WITH_WALLET_ADDRESS/embers-continuations

# --- co-located F1r3drive wallet (see docker/embers-entrypoint.sh) ---
F1R3DRIVE_WALLET_ADDRESS=REPLACE_WITH_WALLET_ADDRESS
F1R3DRIVE_WALLET_KEY=REPLACE_WITH_WALLET_PRIVATE_KEY_HEX
