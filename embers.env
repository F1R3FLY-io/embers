# Embers local dev config — pointing at Rust shard on f1r3fly network
# Run: docker run --env-file ./embers.env --network f1r3fly -p 8080:3000 f1r3flyio/embers:latest

# Server
EMBERS__PORT=3000
EMBERS__ADDRESS=::
EMBERS__LOG_LEVEL=debug
EMBERS__AES_ENCRYPTION_KEY=48E37E0E448C482ADEAE83CD15FE91AA4E2459ED67D707BB40EF17BB18E60EE4

# Mainnet — validator1 for writes, readonly for reads
# Ports are internal Docker ports (all nodes use 40400-40405 internally)
EMBERS__MAINNET__DEPLOY_SERVICE_URL=http://rnode.validator1:40401
EMBERS__MAINNET__PROPOSE_SERVICE_URL=http://rnode.validator1:40402
EMBERS__MAINNET__VALIDATOR_WS_API_URL=ws://rnode.validator1:40403
EMBERS__MAINNET__OBSERVER_URL=http://rnode.readonly:40403
EMBERS__MAINNET__OBSERVER_WS_API_URL=ws://rnode.readonly:40403

# Bootstrap wallet key
EMBERS__MAINNET__SERVICE_KEY=5f668a7ee96d944a4494cc947e4005e172d7ab3461ee5538f1f2a45a835e9657
EMBERS__MAINNET__WALLETS_ENV_KEY=8BDC54B5551812C43428EB172A2079ABBEF13B5370BB7535F78807CDEBA3E7B3
EMBERS__MAINNET__AGENTS_ENV_KEY=69D4BC8ED86915383E68FAF1E4F9D8E22E02CDD3702730C61FE3B45FBBDF0097
EMBERS__MAINNET__AGENTS_TEAMS_ENV_KEY=85348C6D6AEF0B4761F8B8047111B3A2F7C9DF8CB24F91B66B77893DDE21DEE5
EMBERS__MAINNET__OSLFS_ENV_KEY=E6441631C4E164BF13A0532BF6775606965089CE3750E5ED39AAA9EC0DF81E67

# Testnet — same cluster for local dev
EMBERS__TESTNET__DEPLOY_SERVICE_URL=http://rnode.validator1:40401
EMBERS__TESTNET__PROPOSE_SERVICE_URL=http://rnode.validator1:40402
EMBERS__TESTNET__VALIDATOR_WS_API_URL=ws://rnode.validator1:40403
EMBERS__TESTNET__OBSERVER_URL=http://rnode.readonly:40403
EMBERS__TESTNET__OBSERVER_WS_API_URL=ws://rnode.readonly:40403
EMBERS__TESTNET__SERVICE_KEY=5f668a7ee96d944a4494cc947e4005e172d7ab3461ee5538f1f2a45a835e9657
EMBERS__TESTNET__ENV_KEY=D1BD29C232D11142E852EEE23482B239AF5494DFA10D64E82A72A8CDF82D5127

# Observer sync — controls how embers waits for blockchain state consistency.
# The observer's explore-deploy may lag behind the validator's finalized state.
# These settings control the retry behavior for prepare endpoints that read
# state before generating contracts.
#
# EMBERS__BOOTSTRAP_TIMEOUT_SECS=120
# EMBERS__OBSERVER_SYNC_ATTEMPTS=15
# EMBERS__OBSERVER_SYNC_INTERVAL_SECS=2
# EMBERS__DEPLOY_FINALIZATION_TIMEOUT_SECS=120
# EMBERS__READ_AFTER_FINALIZE_ATTEMPTS=15
