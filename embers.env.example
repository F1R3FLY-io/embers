# =================================================================
# Embers Environment Configuration
# =================================================================
# Copy this file and fill in your values:
#   cp embers.env.example embers.env
#
# Run with Docker:
#   docker run --env-file ./embers.env --network <node-network> -p 3000:3000 f1r3flyio/embers:latest
#
# All variables use the EMBERS__ prefix with __ as the nesting separator.

# -----------------------------------------------------------------
# Server
# -----------------------------------------------------------------
EMBERS__PORT=3000
EMBERS__ADDRESS=::
EMBERS__LOG_LEVEL=info

# AES-256 encryption key (32 bytes, hex-encoded, 64 hex chars)
EMBERS__AES_ENCRYPTION_KEY=<64-char-hex-string>

# -----------------------------------------------------------------
# Mainnet Cluster
# -----------------------------------------------------------------
# gRPC DeployService on the validator node (doDeploy, getBlock, etc.)
EMBERS__MAINNET__DEPLOY_SERVICE_URL=http://<validator-host>:40401

# gRPC ProposeService on the validator node (propose, proposeResult)
EMBERS__MAINNET__PROPOSE_SERVICE_URL=http://<validator-host>:40402

# WebSocket event stream on the validator (BlockAdded, BlockFinalised, etc.)
EMBERS__MAINNET__VALIDATOR_WS_API_URL=ws://<validator-host>:40403

# HTTP REST API on the observer node (POST /api/explore-deploy)
EMBERS__MAINNET__OBSERVER_URL=http://<observer-host>:40403

# WebSocket event stream on the observer
EMBERS__MAINNET__OBSERVER_WS_API_URL=ws://<observer-host>:40403

# Wallet private key (secp256k1, hex) — must map to a funded genesis wallet
EMBERS__MAINNET__SERVICE_KEY=<64-char-hex-private-key>

# Encryption keys for on-chain data (secp256k1 private keys, hex)
EMBERS__MAINNET__WALLETS_ENV_KEY=<64-char-hex-private-key>
EMBERS__MAINNET__AGENTS_ENV_KEY=<64-char-hex-private-key>
EMBERS__MAINNET__AGENTS_TEAMS_ENV_KEY=<64-char-hex-private-key>
EMBERS__MAINNET__OSLFS_ENV_KEY=<64-char-hex-private-key>

# -----------------------------------------------------------------
# Testnet Cluster
# -----------------------------------------------------------------
# Same structure as mainnet. For single-cluster setups, point to
# the same nodes as mainnet.
EMBERS__TESTNET__DEPLOY_SERVICE_URL=http://<validator-host>:40401
EMBERS__TESTNET__PROPOSE_SERVICE_URL=http://<validator-host>:40402
EMBERS__TESTNET__VALIDATOR_WS_API_URL=ws://<validator-host>:40403
EMBERS__TESTNET__OBSERVER_URL=http://<observer-host>:40403
EMBERS__TESTNET__OBSERVER_WS_API_URL=ws://<observer-host>:40403

# Wallet private key (secp256k1, hex) — must map to a funded genesis wallet
EMBERS__TESTNET__SERVICE_KEY=<64-char-hex-private-key>

# Encryption key for testnet data
EMBERS__TESTNET__ENV_KEY=<64-char-hex-private-key>
