@startuml 45-f1r3drive-mount
' Continuation-store mount verification (verify_f1r3drive_mount).
' Palette: F1r3drive/FUSE #E8DACB / line #A67C52; per docs/diagrams/README.md.
skinparam backgroundColor #F8FBFF
skinparam shadowing false
skinparam ArrowColor #294C60
skinparam defaultFontName "DejaVu Sans"
skinparam activity {
  BackgroundColor #E8DACB
  BorderColor #A67C52
  DiamondBackgroundColor #FDE9D9
  DiamondBorderColor #294C60
}

title F1r3drive mount verification — fail-closed continuation placement

start
:continuation store opens at MOUNT_PATH;
if (path is absolute\nand a directory?) then (no)
  #F8CECC:bail: invalid mount path;
  stop
endif
:canonicalize the path;
:read /proc/self/mountinfo;
partition "For each mount line (split on \" - \")" {
  if (canonical path\nstarts_with field[4]\n(mount point)?) then (yes)
    if (post-separator field[0]\n(fs type) starts_with "fuse"?) then (yes)
      if (post-separator field[1]\n(mount source) contains "f1r3drive"?) then (yes)
        #CFE2F3:matched: FUSE fsname=f1r3drive;
      else (no)
      endif
    else (no)
    endif
  else (no)
  endif
}
if (a matching mount was found?) then (yes)
  :proceed — place encrypted continuations\non the F1r3drive mount;
  stop
else (no)
  #F8CECC:bail: refuse to place continuations\non ordinary disk;
  stop
endif
@enduml
