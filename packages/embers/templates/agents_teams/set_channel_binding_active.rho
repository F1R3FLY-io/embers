new deployId(`rho:rchain:deployId`), rl(`rho:registry:lookup`),
    agentsTeamsCh, acknowledged, forward
in {
    contract forward(@value, destination) = { destination!(value) } |
    rl!({{ env_uri }}, *agentsTeamsCh) |
    for(@(_, agentsTeams) <- agentsTeamsCh) {
        @agentsTeams!("setChannelBindingActive",
            {{ channel }},
            {{ channel_address }},
            {{ active }},
            *acknowledged) |
        for(@ack <- acknowledged) {
            forward!(ack, (*deployId).toString())
        }
    }
}
