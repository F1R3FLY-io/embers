{% extends "common/insert_signed.rho" %}

{%- block name -%} agentsTeam {%- endblock -%}

{%- block initialization -%}
{%- filter indent(8) -%}

new devNull(`rho:io:devNull`)
{%- if !system_channels.is_empty() %}
    ,{{ system_channels | join(",\n") | indent(4) }}
{%- endif %}
in {
    contract agentsTeam(@"control", @"manifest", return) = {
        return!({
            "definition": {{ definition_json }},
            "definitionHash": {{ definition_hash }},
            "protocol": "embers-agent-team-control-v1"
        })
    } |
    contract agentsTeam(@"control", @"guard", @transitionId, @value, @input, @state, return) = {
        {{ guard_dispatch }}
    } |
    contract agentsTeam(@"control", @"activity", @nodeId, @input, return) = {
        {{ activity_dispatch }}
    } |
    contract agentsTeam(@input, return) = {
        new {{ private_channels | join(",\n") | indent(12) }}
        in {
{%- if !initializers.is_empty() %}
            {{ initializers | join(" |\n") | indent(12) }}
            |
{%- endif %}
            {{ contracts | join(" |\n") | indent(12) }}
            |
            {{ starts | join(" |\n") | indent(12) }}
        }
    }
}

{%- endfilter -%}
{%- endblock -%}
