{% extends "common/insert_signed.rho" %}
{%- block name -%} deploymentContainer {%- endblock -%}
{%- block initialization -%}
new devNull(`rho:io:devNull`)
{%- if !system_channels.is_empty() %}
    ,{{ system_channels | join(",\n") }}
{%- endif %}
in {
    contract deploymentContainer(@"control", @"manifest", return) = {
        return!({"containerId": {{ container_id }}, "definitionHash": {{ definition_hash }}, "target": "current"})
    } |
    contract deploymentContainer(@"activity", @nodeId, @input, return) = {
        {{ dispatch }}
    }
}
{%- endblock -%}
